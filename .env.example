# Year Well Built — environment variables
# Copy to .env for local development. Never commit real keys.

# --- Public (exposed to the browser, safe to be seen) ---
# Umami analytics. Leave BLANK and all analytics become silent no-ops.
PUBLIC_UMAMI_SITE_ID=
PUBLIC_UMAMI_SCRIPT_URL=https://analytics.stff.me/script.js

# Where the Clarity Session CTA points. Swap for the real booking link when live.
PUBLIC_BOOKING_URL=https://mattrutherfordcoaching.com/?source=ywb

# The header "Coaching" link. Kept separate from PUBLIC_BOOKING_URL so that
# swapping in a booking page doesn't repoint the header.
PUBLIC_COACHING_URL=https://mattrutherfordcoaching.com/?source=ywb

# The header "Newsletter" link. Leave BLANK to hide the link entirely
# (the Values Finder does the same). Its own .env.example uses
# https://www.mattrutherford.co.uk
PUBLIC_NEWSLETTER_URL=https://www.mattrutherford.co.uk

# The Values Finder, for the two-way hand-off.
PUBLIC_VALUES_FINDER_URL=https://thevaluesfinder.com

# Canonical site origin, used for return URLs and the .ics download.
PUBLIC_SITE_URL=https://yearwellbuilt.com

# --- Server only (never exposed to the browser) ---
PORT=3000

# Resend. Sends the vision document from yearwellbuilt.com.
RESEND_API_KEY=
MAIL_FROM="Matt at Year Well Built <hello@yearwellbuilt.com>"
MAIL_REPLY_TO=matt@mattrutherford.co.uk

# Ghost newsletter. Only used when the visitor ticks the newsletter box.
# Use the NON-redirecting Ghost URL or the auth header is stripped (403).
GHOST_ADMIN_API_URL=
GHOST_ADMIN_API_KEY=
GHOST_MEMBER_LABEL=ywb
