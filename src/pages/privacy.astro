---
import Base from "../layouts/Base.astro";
import StorageControls from "../islands/StorageControls.jsx";
import { doc, text, section, labelsOf, inline } from "../lib/content.js";
import { CONTACT_EMAIL } from "../lib/config.js";

const d = doc("privacy");
const full = section(d, "Full page");
const heading = labelsOf(d, "Full page").Heading || "Your answers are yours";

// Intro paragraphs, then the bullet list of promises.
const lines = full?.body || [];
const intro = lines
  .filter((l) => l.trim() && !l.startsWith("-") && !l.includes("**Heading:**"))
  .map((l) => l.trim());
const points = lines
  .filter((l) => /^\s*-\s+/.test(l))
  .map((l) => l.replace(/^\s*-\s+/, "").trim())
  .map((l) => l.replace("[CONTACT EMAIL]", CONTACT_EMAIL));
const ledes = intro.filter((p) => !p.startsWith("Questions?"));
const shortVersion = text(d, "Short version (landing page and footer)");
---
<Base title="Privacy" description={shortVersion}>
  <main id="main" class="privacy">
    <p class="back-link">
      <a href="/" data-back>&larr; Back</a>
    </p>

    <div class="intro">
      <p class="label">Privacy</p>
      <h1>{heading}</h1>
      {ledes[0] && <p class="lede" set:html={inline(ledes[0])}></p>}
    </div>
    {ledes.slice(1).map((p) => <p class="lede" set:html={inline(p)}></p>)}

    <ul class="privacy-points">
      {points.map((p) => <li set:html={inline(p)}></li>)}
    </ul>

    <p class="muted">
      Questions? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
    </p>

    <section class="privacy-controls">
      <h2>Your answers, right now</h2>
      <StorageControls client:visible expanded />
    </section>
  </main>
</Base>

<script is:inline>
  /* The privacy page is a detour, so "back" should mean back to where you
     were, not to the landing page. Falls back to the href when there is no
     same-origin referrer (a direct visit, or arriving from a search). */
  (() => {
    const link = document.querySelector("[data-back]");
    if (!link) return;
    let from = null;
    try { from = document.referrer ? new URL(document.referrer) : null; } catch {}
    if (from && from.origin === window.location.origin && from.pathname !== window.location.pathname) {
      link.setAttribute("href", from.pathname + from.search);
      link.textContent = "\u2190 Back to where you were";
    }
  })();
</script>

<style>
  /* Left-aligned in the same 1120px container as every other page: this was
     sitting 180px right of the header. */
  .privacy { display: grid; gap: var(--sp-5); padding-block: var(--sp-6) var(--sp-10); }
  .privacy > * { max-width: var(--prose); }
  .back-link { font-size: var(--step--1); }
  .back-link a { color: var(--mr-muted); text-decoration: none; }
  .back-link a:hover { color: var(--mr-accent); }
  .privacy-points { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-4); }
  .privacy-points li {
    padding-left: var(--sp-6); position: relative; color: var(--mr-muted); max-width: var(--measure);
  }
  .privacy-points li::before {
    content: ""; position: absolute; left: 0; top: 0.72em;
    width: 12px; height: 1px; background: var(--mr-accent);
  }
  .privacy-points :global(strong) { color: var(--mr-ink); font-weight: 500; }
  .privacy-controls { border-top: var(--border); padding-top: var(--sp-6); display: grid; gap: var(--sp-3); }
  .privacy-controls h2 { font-size: 1.5rem; }
</style>
