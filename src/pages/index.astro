---
import Base from "../layouts/Base.astro";
import StartActions from "../islands/StartActions.jsx";
import { doc, text, bulletsOf, labelsOf, inline } from "../lib/content.js";
import { STEPS } from "../lib/steps.js";

/*
  Laid out to mirror thevaluesfinder.com's welcome screen, so the two read as
  one family: eyebrow + headline + ledes + hairline list + action on the left,
  and an example of what you end up with on the right.

  Both columns start with a .label on the same baseline — which is why the
  right-hand label sits OUTSIDE the card, not inside it.
*/

const d = doc("landing");
const eyebrow = text(d, "Eyebrow");
const headline = text(d, "Headline").replace(/^\*\*Recommended:\*\*\s*/, "");
const subhead = text(d, "Subhead");
const benefits = bulletsOf(d, "Three benefit lines");
const privacyLine = text(d, "Privacy line");
const startLabel = text(d, "Start button label");
const timeLine = text(d, "Time line (under the button)");

// "Buttons: Continue where you left off / Start again"
const example = labelsOf(d, "Example plan (right-hand card)");

const returning = labelsOf(d, "Returning visitor");
const [continueLabel, restartLabel] = (returning.Buttons || "")
  .split("/").map((x) => x.trim());
const valuesLine = returning["Values confirmation"] || "";
---
<Base title={null} description={subhead}>
  <main id="main">
    <section class="hero">
      <div class="copy">
        <p class="label">{eyebrow}</p>
        <h1 set:html={inline(headline)}></h1>

        <div class="ledes">
          <p class="lede">{subhead}</p>
        </div>

        <ul class="plan">
          {benefits.map((b) => {
            const m = /^\*\*(.+?)\*\*\s*(.*)$/.exec(b);
            return (
              <li>
                <b>{m ? m[1].replace(/\.$/, "") : b}</b>
                {m && <span>{m[2]}</span>}
              </li>
            );
          })}
        </ul>

        <StartActions
          client:load
          startLabel={startLabel}
          continueLabel={continueLabel}
          restartLabel={restartLabel}
          valuesLine={valuesLine}
          timeLine={timeLine}
          privacyLine={privacyLine}
        />
      </div>

      <aside class="sample" aria-label="An example plan">
        <p class="label">Example plan</p>
        <div class="paper">
          <p class="label">
            {example.Label || "Annual plan"}
            {/* Rendered client-side so the example never shows a stale date —
                a static build would freeze whatever day it was built. */}
            <span class="sample-date" data-today></span>
          </p>
          <h2 class="sample-title">{example.Title || "Alex's annual plan"}</h2>
          <div class="mini">
            <ol>
              {STEPS.map((s) => (
                <li>
                  <span class="n">{s.n}</span>
                  <b>{s.title}</b>
                  <span>{example[String(s.n)] || s.blurb}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </aside>

    </section>
  </main>
</Base>

<script is:inline>
  // Same format as the Values Finder's report date. Kept out of the build so
  // the example never shows the day the site was last deployed.
  document.querySelectorAll("[data-today]").forEach((el) => {
    el.textContent = new Date().toLocaleDateString("en-GB", {
      day: "numeric", month: "long", year: "numeric",
    });
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--sp-9);
    align-items: start;
    padding-block: var(--sp-7) var(--sp-8);
  }

  /* Both columns open with a .label, so their first baselines line up. */
  .copy { display: grid; gap: var(--sp-6); max-width: 36rem; align-content: start; }
  .copy > .label { margin-bottom: calc(-1 * var(--sp-3)); }
  .sample { display: grid; gap: var(--sp-6); align-content: start; }
  .sample > .label { margin-bottom: calc(-1 * var(--sp-3)); }

  h1 { margin: 0; }
  .ledes { display: grid; gap: var(--sp-4); }

  /* Hairline rows, as on thevaluesfinder.com's welcome list. */
  .plan { list-style: none; margin: 0; padding: 0; border-top: var(--border); }
  .plan li {
    display: grid; gap: var(--sp-1);
    padding: var(--sp-4) 0; border-bottom: var(--border);
  }
  .plan b { font-weight: 500; line-height: 1.5; }
  .plan span { color: var(--muted); font-size: 0.92rem; }

  /* Buttons, then the quiet lines beneath them — the Values Finder's rhythm. */
  .start-actions { display: grid; gap: var(--sp-3); }
  .start-actions .row { margin-bottom: var(--sp-5); }
  .start-actions .note { max-width: var(--measure); }
  .start-actions .is-confirm { color: var(--accent); }

  .paper { display: grid; gap: var(--sp-2); }
  .sample-title { font-size: 1.9rem; margin-top: var(--sp-1); }
  .sample-date:not(:empty)::before { content: " · "; }

  .mini { display: grid; gap: var(--sp-4); margin-top: var(--sp-4); }
  .mini ol { margin: 0; padding: 0; display: grid; gap: var(--sp-4); }
  .mini li { list-style: none; display: grid; grid-template-columns: 1.6rem 1fr; gap: 2px var(--sp-3); }
  .mini .n { grid-row: span 2; color: var(--accent); font-size: 0.92rem; line-height: 1.5; }
  .mini b { font-weight: 500; font-size: 0.95rem; line-height: 1.5; }
  .mini span:not(.n) { font-size: var(--step--1); color: var(--muted); }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: var(--sp-8); padding-block: var(--sp-5) var(--sp-8); }
    .sample { order: -1; }
    .mini { display: none; }
  }
</style>
