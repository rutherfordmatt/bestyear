---
/*
  EXPERIMENT — one question per screen, as a deck of cards.
  Step 1's content, side by side with the real /step/1 for comparison.
*/
import Base from "../../layouts/Base.astro";
import PhaseRail from "../../islands/PhaseRail.jsx";
import Step1Cards from "../../islands/Step1Cards.jsx";
import { stepCopy, inline } from "../../lib/content.js";

const copy = stepCopy(1);
---
<Base title={`Experiment — ${copy.titlePlain}`} description="One question per screen.">
  <PhaseRail client:load current={1} />

  <main id="main" class="step-layout deck-layout">
    <p class="experiment-flag">
      Experiment · one question per screen.
      <a href="/step/1">Compare with the current Step 1</a>
    </p>

    {/* No permanent header: the title and the framing are the first card. */}
    <Step1Cards
      client:load
      prompts={copy.prompts}
      titleHtml={inline(copy.title)}
      intro={[copy.promise, ...copy.intro]}
      transition={copy.transition}
    />
  </main>
</Base>
