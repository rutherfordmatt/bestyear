---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="That page isn't here.">
  <main id="main" class="prose notfound">
    <p class="label">404</p>
    <h1>That page isn't here</h1>
    <p class="lede">
      The link may be old, or mistyped. Your answers are safe either way —
      they're saved in this browser, not on a server.
    </p>
    <div class="row">
      <a class="btn primary" href="/">Back to the start</a>
      <a class="btn text" href="/step/1">Carry on where you left off</a>
    </div>
  </main>
</Base>

<style>
  .notfound { display: grid; gap: var(--sp-5); padding-block: var(--sp-9) var(--sp-10); }
</style>
