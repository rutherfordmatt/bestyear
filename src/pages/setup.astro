---
import Base from "../layouts/Base.astro";
import StepDeck from "../components/StepDeck.astro";
import SetupCards from "../islands/SetupCards.jsx";
import { doc, text, paras, inline, plain } from "../lib/content.js";

const d = doc("setup");
const title = text(d, "Title");
const intro = paras(d, "Intro");
const transition = text(d, "Transition");

const paceSection = d.sections["Pace choice"];
const paceOptions = (paceSection ? paceSection.body : [])
  .filter((l) => /^\s*-\s+\*\*/.test(l))
  .map((l) => {
    const m = /^\s*-\s+\*\*(.+?)\*\*\s*(.*)$/.exec(l);
    return m ? { title: m[1].replace(/\.$/, ""), body: m[2].trim() } : null;
  })
  .filter(Boolean)
  .map((o, i) => ({ ...o, key: i === 0 ? "sitting" : "daily" }));

const paceQuestion = ((paceSection ? paceSection.body : [])
  .find((l) => /^\*\*.+\*\*$/.test(l.trim())) || "")
  .replace(/\*\*/g, "").trim();

const promptHeading = d.sections["Prompt: the year that's ending"];
const promptBody = promptHeading ? promptHeading.body : [];
const grab = (label) => {
  const line = promptBody.find((l) => l.includes(`${label}:`));
  return line ? line.split(":").slice(1).join(":").replace(/^\s*-\s*/, "").trim() : "";
};
const prompt = {
  question: (promptBody.find((l) => /^\*\*/.test(l)) || "").replace(/\*\*/g, "").trim(),
  example: grab("Placeholder example"),
  hint: grab("Stuck? hint"),
};
---
<Base title={plain(title)} description="Two quick choices before you start." storage>
  <StepDeck step={0}>
    <SetupCards
      client:load
      paceOptions={paceOptions}
      paceQuestion={paceQuestion}
      prompt={prompt}
      titleHtml={inline(title)}
      intro={intro}
      transition={transition}
    />
  </StepDeck>
</Base>
