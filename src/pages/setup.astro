---
import Base from "../layouts/Base.astro";
import Setup from "../islands/Setup.jsx";
import PhaseRail from "../islands/PhaseRail.jsx";
import StepBar from "../islands/StepBar.jsx";
import StorageControls from "../islands/StorageControls.jsx";
import { doc, text, paras, promptsOf, inline, plain } from "../lib/content.js";

const d = doc("setup");
const title = text(d, "Title");
const intro = paras(d, "Intro");
const transition = text(d, "Transition");

// "- **In one sitting.** Clear an hour..." — bold lead-in, then the body.
const paceSection = d.sections["Pace choice"];
const paceOptions = (paceSection ? paceSection.body : [])
  .filter((l) => /^\s*-\s+\*\*/.test(l))
  .map((l) => {
    const m = /^\s*-\s+\*\*(.+?)\*\*\s*(.*)$/.exec(l);
    return m ? { title: m[1].replace(/\.$/, ""), body: m[2].trim() } : null;
  })
  .filter(Boolean)
  .map((o, i) => ({ ...o, key: i === 0 ? "sitting" : "daily" }));

// The year-ending prompt sits under a plain heading, not a "### Prompt N".
const promptHeading = d.sections["Prompt: the year that's ending"];
const promptBody = promptHeading ? promptHeading.body : [];
const grab = (label) => {
  const line = promptBody.find((l) => l.includes(`${label}:`));
  return line ? line.split(":").slice(1).join(":").replace(/^\s*-\s*/, "").trim() : "";
};
const prompt = {
  question: (promptBody.find((l) => /^\*\*/.test(l)) || "").replace(/\*\*/g, "").trim(),
  example: grab("Placeholder example"),
  hint: grab("Stuck? hint"),
};
---
<Base title={plain(title)} description="Two quick choices before you start." bodyClass="has-bar">
  <PhaseRail client:load current={0} />

  <div class="step-layout">
    <article class="step-main">
      <div class="intro">
        <p class="label">Before we start</p>
        <h1 set:html={inline(title)}></h1>
        <p class="lede">{intro[0]}</p>
      </div>

      <Setup client:load paceOptions={paceOptions} prompt={prompt} transition={transition} />

      <StorageControls client:visible />
    </article>
  </div>

  <StepBar client:load step={0} />
</Base>
