---
import Base from "../../layouts/Base.astro";
import StepDeck from "../../components/StepDeck.astro";
import Step2Cards from "../../islands/Step2Cards.jsx";
import { stepCopy, doc, text, labelsOf, bulletsOf, inline } from "../../lib/content.js";

const copy = stepCopy(2);
const d = doc("step-2");
const f = labelsOf(d, "Values Finder card");
const card = {
  heading: f.Heading || "", body: f.Body || "",
  primary: f["Primary button"] || "Find my values",
  secondary: f["Secondary link"] || "",
};
const returnLine = text(d, "Returning from Values Finder (confirmation line)");
const byName = (n) => copy.prompts.find((p) => p.name.toLowerCase().includes(n)) || {};
const prompts = {
  choose: byName("choose"), alignment: byName("alignment"), gap: byName("gap"),
  letting: byName("letting go"), closing: byName("one line"),
};
const bucketLabels = bulletsOf(d, "Prompts", "Prompt 4: Letting go")
  .map((b) => b.replace(/\*\*/g, "").trim())
  .filter((b) => /stopping|stepping back|carrying/i.test(b));
---
<Base title={copy.titlePlain} description={copy.promise} storage>
  <StepDeck step={2}>
    <Step2Cards
      client:load
      card={card}
      returnLine={returnLine}
      prompts={prompts}
      bucketLabels={bucketLabels}
      titleHtml={inline(copy.title)}
      intro={[copy.promise, ...copy.intro]}
      transition={copy.transition}
    />
  </StepDeck>
</Base>
