---
import Base from "../../layouts/Base.astro";
import StepDeck from "../../components/StepDeck.astro";
import Step7Cards from "../../islands/Step7Cards.jsx";
import { stepCopy, doc, promptsOf, section, inline } from "../../lib/content.js";

const copy = stepCopy(7);
const d = doc("step-7");

const alive = promptsOf(d).find((p) => p.name.toLowerCase().includes("keep it alive"));
const livesOptions = (alive?.options || "").split("/").map((s) => s.trim()).filter(Boolean);

const actionsSection = section(d, "Actions");
const actionFields = {};
for (const line of actionsSection?.body || []) {
  const m = /^\s*-\s+(?:\*\*)?([A-Za-z][A-Za-z ()]*?)(?:\*\*)?\s*:\s*(.+)$/.exec(line);
  if (m) actionFields[m[1].trim()] = m[2].replace(/\*\*/g, "").trim();
}
const actions = {
  line: actionFields["Line"] || "",
  fieldLabel: actionFields["Field label"] || "Your email",
  checkbox: actionFields["Checkbox (unticked)"] || "",
  button: actionFields["Button"] || "Send my plan",
  success: actionFields["Success"] || "",
};
---
<Base title={copy.titlePlain} description={copy.promise} storage>
  <StepDeck step={7}>
    <Step7Cards
      client:load
      prompts={copy.prompts}
      livesOptions={livesOptions}
      actions={actions}
      titleHtml={inline(copy.title)}
      intro={[copy.promise, ...copy.intro]}
    />
  </StepDeck>
</Base>
