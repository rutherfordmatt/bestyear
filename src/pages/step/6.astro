---
import Base from "../../layouts/Base.astro";
import StepDeck from "../../components/StepDeck.astro";
import Step6Cards from "../../islands/Step6Cards.jsx";
import { stepCopy, doc, text, promptsOf, inline } from "../../lib/content.js";

const copy = stepCopy(6);
const d = doc("step-6");
const coachNote = text(d, 'Coaching touchpoint (shown if "A coach" is selected)')
  .replace(/\s*\[Find out more\]\s*$/, "");
const cornerPrompt = promptsOf(d).find((p) => p.name.toLowerCase().includes("corner"));
const cornerOptions = (cornerPrompt?.options || "").split("/").map((s) => s.trim()).filter(Boolean);
---
<Base title={copy.titlePlain} description={copy.promise} storage>
  <StepDeck step={6}>
    <Step6Cards
      client:load
      prompts={copy.prompts}
      coachNote={coachNote}
      cornerOptions={cornerOptions}
      titleHtml={inline(copy.title)}
      intro={[copy.promise, ...copy.intro]}
      transition={copy.transition}
    />
  </StepDeck>
</Base>
