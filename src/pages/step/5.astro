---
import Base from "../../layouts/Base.astro";
import StepDeck from "../../components/StepDeck.astro";
import Step5Cards from "../../islands/Step5Cards.jsx";
import { stepCopy, inline } from "../../lib/content.js";

const copy = stepCopy(5);
---
<Base title={copy.titlePlain} description={copy.promise}>
  <StepDeck step={5}>
    <Step5Cards
      client:load
      prompts={copy.prompts}
      titleHtml={inline(copy.title)}
      intro={[copy.promise, ...copy.intro]}
      transition={copy.transition}
    />
  </StepDeck>
</Base>
