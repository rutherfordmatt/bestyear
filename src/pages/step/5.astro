---
import Base from "../../layouts/Base.astro";
import StepShell from "../../components/StepShell.astro";
import Step5 from "../../islands/Step5.jsx";
import { stepCopy } from "../../lib/content.js";

const copy = stepCopy(5);
---
<Base title={copy.title} description={copy.promise}>
  <main id="main">
    <StepShell step={5}>
      <Step5 client:load prompts={copy.prompts} />
    </StepShell>
  </main>
</Base>
