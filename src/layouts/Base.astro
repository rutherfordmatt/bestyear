---
import "../styles/fonts.css";
import "../styles/brand-tokens.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/step.css";
import "../styles/document.css";
import "../styles/print.css";
import Umami from "../components/Umami.astro";
import StorageControls from "../islands/StorageControls.jsx";
import { SITE_NAME, TAGLINE, COACHING_URL, NEWSLETTER_URL, SITE_URL } from "../lib/config.js";

const {
  title,
  description = "A free, guided review and plan in seven steps. Finish with a one-page vision for the year ahead. Private by design.",
  bodyClass = "",
  // Pages where answers exist carry the footing — "your answers stay on this
  // device", and the way to back them up or clear them. It lives in the
  // footer rather than above it: two rules a few lines apart read as two
  // footers, and the visitor only has one.
  storage = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — ${TAGLINE}`;
const ogImage = new URL("/og.png", SITE_URL).href;
---
<!DOCTYPE html>
<html lang="en-IE" data-site="year">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAFAF8" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_IE" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Year Well Built, by Matt Rutherford." />
    <meta name="twitter:card" content="summary_large_image" />
    <Umami />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site no-print">
      <a class="brand" href="/">
        <img src="/logo/lockup.svg" alt="Year Well Built" width="228" height="48" />
      </a>
      <nav class="links" aria-label="Site">
        <a href={COACHING_URL} data-umami-event="coaching-click" data-umami-event-from="header">
          Coaching
        </a>
        {NEWSLETTER_URL && (
          <a href={NEWSLETTER_URL} data-umami-event="newsletter-click" data-umami-event-from="header">
            Newsletter
          </a>
        )}
      </nav>
    </header>

    <slot />

    <footer class={`site no-print${storage ? " with-storage" : ""}`}>
      {storage && <StorageControls client:visible showPrivacy={false} />}
      <div class="footer-meta">
        <span>© Matt Rutherford Coaching</span>
        <a href="/privacy">Privacy</a>
      </div>
    </footer>
  </body>
</html>
