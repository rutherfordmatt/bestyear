---
/*
  The frame every step shares, following the same shape as a Values Finder
  inner screen: progress rail at the top, an .intro block (label, title with
  its italic accent, lede), the step's own content, then a fixed bottom bar
  carrying where-you-are and what's next.

  Copy comes from content/step-N.md. The interactive part of each step is
  passed in as the default slot.
*/
import PhaseRail from "../islands/PhaseRail.jsx";
import StepSummary from "../islands/StepSummary.jsx";
import SoftNote from "../islands/SoftNote.jsx";
import StepBar from "../islands/StepBar.jsx";
import StorageControls from "../islands/StorageControls.jsx";
import { stepCopy, inline } from "../lib/content.js";
import { STEPS } from "../lib/steps.js";

const { step } = Astro.props;
const n = Number(step);
const copy = stepCopy(n);
---
<PhaseRail client:load current={n} />

<div class="step-layout">
  <article class="step-main">
    <div class="intro">
      <p class="label">Step {n} of {STEPS.length}</p>
      <h1 set:html={inline(copy.title)}></h1>
      <p class="lede">{copy.promise}</p>
    </div>

    <div class="step-intro">
      {copy.intro.map((p) => <p set:html={inline(p)}></p>)}
    </div>

    <slot />

    {copy.softNote && (
      <SoftNote client:load step={n} paragraphs={copy.softNote} />
    )}

    <StepSummary client:load step={n} transition={copy.transition} />
    <StorageControls client:visible />
  </article>
</div>

<StepBar client:load step={n} />

<script is:inline define:vars={{ eventName: `step-${n}-reached` }}>
  // One Umami event per step reached. window.umami only exists when
  // PUBLIC_UMAMI_SITE_ID is set, so this is a silent no-op until then.
  (function track() {
    if (window.umami?.track) { window.umami.track(eventName); return; }
    window.addEventListener("load", () => window.umami?.track?.(eventName), { once: true });
  })();
</script>
